(version 1)
; Build phase: deny-default. A finite /usr+/System+/private read allowlist
; SIGABRTs node on macOS firmlinks (dyld shared cache). (subpath "/") is the
; only filter that maps the cache; it is not a filter-less (allow file-read*).
; /etc and /private/etc are then denied except localtime so Vite cannot import
; passwd/hosts. Operator $HOME is denied; the temp tree, npm cache, node
; prefix, and tz files are re-allowed.
(deny default)
(allow file-read-metadata)
(allow file-map-executable)
(allow file-read* (subpath "/"))
(deny file-read*
  (subpath "__OPERATOR_HOME__")
  (subpath "/etc")
  (subpath "/private/etc")
  (literal "/etc/hosts")
  (literal "/private/etc/hosts")
  (literal "/etc/passwd")
  (literal "/private/etc/passwd")
)
(allow file-read*
  (subpath "__TREE__")
  (subpath "__CACHE__")
  (subpath "__HOME__")
  (subpath "__TMPDIR__")
  (literal "__NODE__")
  (literal "__NODE_REAL__")
  (subpath "__NODE_PREFIX__")
  (subpath "__NODE_LIB__")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/System/Library")
  (literal "/Library/Preferences/.GlobalPreferences.plist")
  (literal "/private/etc/localtime")
  (literal "/etc/localtime")
  (subpath "/private/var/db/timezone")
  (subpath "/var/db/timezone")
  (literal "/dev/null")
  (literal "/dev/urandom")
  (literal "/dev/tty")
  (subpath "/dev")
)
(allow file-write* (subpath "__TREE__") (subpath "__TMPDIR__") (literal "/dev/null") (subpath "/dev"))
; node + esbuild (esbuild lives under the temp tree after install)
(allow process-exec (literal "__NODE__") (literal "__NODE_REAL__") (subpath "__TREE__"))
(allow process-fork)
(allow sysctl-read)
(allow mach-lookup)
(allow signal)
(allow system-socket)
(allow file-ioctl)
(allow ipc-posix-shm)
(allow process-info*)
(allow iokit-open)
(allow mach-priv-host-port)
; network: none
