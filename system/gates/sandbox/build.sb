(version 1)
; Build phase: deny-default with a real file-read allowlist.
; (literal "/") is the root directory inode only — not descendants.
; A root-wide subpath grant would cover the entire filesystem and is not used.
; macOS dyld needs the root directory inode plus cryptex/shared-cache paths.
(deny default)
(allow file-read-metadata)
(allow file-map-executable)
(allow file-read*
  (literal "/")
  (subpath "__TREE__")
  (subpath "__CACHE__")
  (subpath "__HOME__")
  (subpath "__TMPDIR__")
  (literal "__NODE__")
  (literal "__NODE_REAL__")
  (subpath "__NODE_PREFIX__")
  (subpath "__NODE_LIB__")
  (subpath "__BREW_PREFIX__")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/System/Library")
  (subpath "/System/Volumes/Preboot/Cryptexes")
  (subpath "/private/var/db/dyld")
  (subpath "/Library/Apple")
  (literal "/Library/Preferences/.GlobalPreferences.plist")
  (literal "/private/etc/localtime")
  (literal "/etc/localtime")
  (subpath "/private/var/db/timezone")
  (subpath "/var/db/timezone")
  (literal "/dev/null")
  (literal "/dev/urandom")
  (literal "/dev/tty")
  (subpath "/dev")
)
(allow file-write* (subpath "__TREE__") (subpath "__TMPDIR__") (literal "/dev/null") (subpath "/dev"))
; node + esbuild (esbuild lives under the temp tree after install)
(allow process-exec (literal "__NODE__") (literal "__NODE_REAL__") (subpath "__TREE__"))
(allow process-fork)
(allow sysctl-read)
(allow mach-lookup)
(allow signal)
(allow system-socket)
(allow file-ioctl)
(allow ipc-posix-shm)
(allow process-info*)
(allow iokit-open)
(allow mach-priv-host-port)
; network: none
