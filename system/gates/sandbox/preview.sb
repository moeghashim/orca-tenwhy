(version 1)
; Preview phase: deny-default, same file/exec policy as build, bind only the preview port.
(deny default)
(allow file-read-metadata)
(allow file-map-executable)
(allow file-read* (subpath "/"))
(deny file-read*
  (subpath "__OPERATOR_HOME__")
  (subpath "/etc")
  (subpath "/private/etc")
  (literal "/etc/hosts")
  (literal "/private/etc/hosts")
  (literal "/etc/passwd")
  (literal "/private/etc/passwd")
)
(allow file-read*
  (subpath "__TREE__")
  (subpath "__CACHE__")
  (subpath "__HOME__")
  (subpath "__TMPDIR__")
  (literal "__NODE__")
  (literal "__NODE_REAL__")
  (subpath "__NODE_PREFIX__")
  (subpath "__NODE_LIB__")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/System/Library")
  (literal "/Library/Preferences/.GlobalPreferences.plist")
  (literal "/private/etc/localtime")
  (literal "/etc/localtime")
  (subpath "/private/var/db/timezone")
  (subpath "/var/db/timezone")
  (literal "/dev/null")
  (literal "/dev/urandom")
  (literal "/dev/tty")
  (subpath "/dev")
)
(allow file-write* (subpath "__TREE__") (subpath "__TMPDIR__") (literal "/dev/null") (subpath "/dev"))
(allow process-exec (literal "__NODE__") (literal "__NODE_REAL__") (subpath "__TREE__"))
(allow process-fork)
(allow sysctl-read)
(allow mach-lookup)
(allow signal)
(allow system-socket)
(allow file-ioctl)
(allow ipc-posix-shm)
(allow process-info*)
(allow iokit-open)
(allow mach-priv-host-port)
(allow network-bind (local ip "localhost:__PREVIEW_PORT__"))
(allow network-inbound (local ip "localhost:__PREVIEW_PORT__"))
(allow network* (local ip "localhost:__PREVIEW_PORT__"))
