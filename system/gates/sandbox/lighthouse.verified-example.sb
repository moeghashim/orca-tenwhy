(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "/private/tmp/claude-501/-Users-moeghashim-orca-projects-orca-tenwhy/496176e9-b02b-453e-94e3-42c8e857d376/scratchpad/sbx-chrome") (subpath "/private/var/folders/28/jpf5lgdn0635bdx2yw0kljnc0000gn/T") (subpath "/Users/moeghashim/Library/Application Support/Google/Chrome/Crashpad") (literal "/dev/null") (literal "/dev/tty") (subpath "/dev/fd") (regex #"^/dev/ttys[0-9]+$") (literal "/dev/dtracehelper"))
(deny file-read* (subpath "/Users/moeghashim"))
