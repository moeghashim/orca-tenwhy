(version 1)
; Lighthouse/Chrome phase. Chrome cannot run under deny-default in practice;
; this is the orchestrator-verified (allow default) recipe from
; lighthouse.verified-example.sb: write confinement, $HOME read denial with
; Crashpad/Preferences re-allows, network denied except unix sockets and the
; preview + devtools loopback ports. __USER_TEMP__ must be the realpath of
; $(getconf DARWIN_USER_TEMP_DIR) because chrome-launcher mktemp -d -t writes there.
(allow default)
(deny file-write*)
(allow file-write* (subpath "__TREE__") (subpath "__TMPDIR__") (subpath "__USER_TEMP__") (subpath "__CRASHPAD__") (literal "/dev/null") (literal "/dev/tty") (subpath "/dev/fd") (regex #"^/dev/ttys[0-9]+$") (literal "/dev/dtracehelper"))
(deny file-read* (subpath "__OPERATOR_HOME__"))
(allow file-read* (subpath "__CRASHPAD__") (subpath "__PREFS__") (subpath "__TREE__") (subpath "__CACHE__") (subpath "__HOME__") (literal "__OPERATOR_HOME__") (literal "__OPERATOR_HOME__/Library") (literal "__OPERATOR_HOME__/Library/Application Support") (literal "__OPERATOR_HOME__/Library/Application Support/Google") (literal "__OPERATOR_HOME__/Library/Application Support/Google/Chrome"))
(deny network*)
(allow network* (local unix-socket))
(allow network* (remote unix-socket))
(allow network* (local ip "localhost:__DEVTOOLS_PORT__"))
(allow network-outbound (remote ip "localhost:__PREVIEW_PORT__"))
(allow network-outbound (remote ip "localhost:__DEVTOOLS_PORT__"))
