{
  "$meta": { "name": "tenwhy / Loop Graph", "mode": "light", "reference": "shadcn zinc light", "version": "0.1.0" },
  "color": {
    "bg": { "canvas": "#f4f4f5", "surface": "#fafafa", "raised": "#f4f4f5", "inset": "#ffffff" },
    "border": { "default": "#d4d4d8", "subtle": "#e4e4e7", "strong": "#a1a1aa" },
    "text": { "primary": "#18181b", "secondary": "#52525b", "muted": "#71717a", "faint": "#a1a1aa" },
    "accent": { "link": "#2563eb", "linkHover": "#1d4ed8" },
    "status": {
      "running":     { "fg": "#2563eb", "bg": "rgba(37,99,235,0.10)", "border": "rgba(37,99,235,0.28)", "glyph": "◔" },
      "passed":      { "fg": "#059669", "bg": "rgba(5,150,105,0.10)", "border": "rgba(5,150,105,0.28)", "glyph": "✓" },
      "failed":      { "fg": "#dc2626", "bg": "rgba(220,38,38,0.10)", "border": "rgba(220,38,38,0.28)", "glyph": "✕" },
      "needs_human": { "fg": "#b45309", "bg": "rgba(217,119,6,0.12)", "border": "rgba(217,119,6,0.35)", "glyph": "⚑" },
      "queued":      { "fg": "#52525b", "bg": "rgba(113,113,122,0.08)", "border": "rgba(113,113,122,0.22)", "glyph": "○" }
    },
    "aliases": {
      "engagement.new": "status.queued",
      "engagement.complete": "status.passed",
      "run.gate_passed": "status.passed",
      "run.gate_failed": "status.failed",
      "gate.pending": "status.queued"
    },
    "liveFlash": "rgba(37,99,235,0.09)"
  },
  "type": {
    "family": { "ui": "Geist, system-ui, sans-serif", "mono": "'Geist Mono', ui-monospace, monospace" },
    "scale": {
      "display": { "size": 20, "weight": 600, "lineHeight": 1.2 },
      "title":   { "size": 15, "weight": 600, "lineHeight": 1.3 },
      "body":    { "size": 13, "weight": 400, "lineHeight": 1.5 },
      "table":   { "size": 12.5, "weight": 400, "lineHeight": 1.4 },
      "mono":    { "size": 12, "weight": 400, "lineHeight": 1.5, "family": "mono" },
      "micro":   { "size": 11, "weight": 500, "lineHeight": 1.3, "tracking": "0.04em" }
    },
    "numerals": "tabular-nums everywhere data appears"
  },
  "space": { "unit": 4, "scale": [4, 8, 12, 16, 20, 24, 32, 48], "tableRowHeight": 40, "sidebarWidth": 220 },
  "radius": { "badge": 4, "card": 8, "chip": 4 },
  "rules": {
    "statusColorNeverAlone": "every status color is paired with its glyph and lowercase mono label",
    "statusLabelsVerbatim": "labels render the enum value exactly (needs_human, gate_failed) in mono lowercase",
    "readOnly": "no buttons, toggles, or affordances that imply write actions; external links only",
    "liveUpdate": "row bg flashes color.liveFlash for 1.5s on SSE event; heights fixed so rows never shift"
  }
}
